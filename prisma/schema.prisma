generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SchoolProfile {
  id                   String   @id @default("default")
  name                 String   @default("Alfurqan International Academy")
  shortName            String   @default("Alfurqan")
  motto                String   @default("Knowledge and Guidance")
  address              String   @default("Along Dass Road, Bauchi State")
  email                String   @default("admin@alfurqanintlacademy.com")
  phone                String   @default("+234 806 977 0538")
  currentTerm          String   @default("1st Term")
  currentSession       String   @default("2026/2027 Session")
  bankName             String   @default("")
  accountNumber        String   @default("")
  accountName          String   @default("")
  accountantName       String   @default("Administrator") @map("bursarName")
  accountantPin        String   @default("") @map("bursarPin")
  logoUrl              String   @default("/logo.png")
  bankAccountsJson     String?  @default("[]")
  receiptPrefix        String   @default("AFIA/")
  receiptFooterNote    String   @default("Receipt • Valid only with authorized Stamp • Fees paid are non-refundable • All payments subject to bank clearance")
  defaultReceiptFormat String   @default("traditional")
  showStamp            Boolean  @default(true)
  feeStructureJson       String?  @default("[]")
  feeScheduleHistoryJson String?  @default("[]")
  concessionsJson        String?  @default("{}")
  updatedAt              DateTime @updatedAt
}

model StaffUser {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      String   // "Admin"
  pin       String   @default("")
  password  String
  title     String
  avatar    String?
  createdAt DateTime @default(now())
}

model Student {
  id               String    @id @default(uuid())
  regNumber        String    @unique
  fullName         String
  class            String
  gender           String    @default("Male")
  parentName       String
  parentPhone      String
  parentEmail      String?
  totalTermBill    Float     @default(0)
  totalPaid        Float     @default(0)
  balanceRemaining Float     @default(0)
  status           String    @default("UNPAID") // "FULL" | "PARTIAL" | "UNPAID"
  isRepeating      Boolean   @default(false)
  lastPaymentDate  String?
  createdAt        DateTime  @default(now())
  receipts         Receipt[]

  @@index([regNumber])
  @@index([fullName])
  @@index([class])
  @@index([status])
}

model Receipt {
  id                String        @id @default(uuid())
  receiptNumber     String        @unique
  studentId         String
  student           Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  regNumber         String
  studentName       String
  studentClass      String
  parentName        String
  parentPhone       String
  parentEmail       String?
  amountPaid        Float
  totalTermBill     Float
  previousTotalPaid Float
  newTotalPaid      Float
  balanceRemaining  Float
  paymentStatus     String        // "FULL" | "PARTIAL"
  paymentMethod     String        // "Bank Transfer" | "Bank Deposit" | "POS" | "Cash"
  bankReference     String?
  bankName          String?       @default("Jaiz Bank")
  term              String
  session           String
  date              String
  timestamp         DateTime      @default(now())
  issuedBy          String
  qrCodeDataUrl     String?       @db.Text
  securityHash      String
  notes             String?
  isVoided          Boolean       @default(false)
  voidReason        String?
  voidedAt          DateTime?
  voidedBy          String?
  items             ReceiptItem[]

  @@index([receiptNumber])
  @@index([studentId])
  @@index([regNumber])
  @@index([date])
  @@index([paymentStatus])
}

model ReceiptItem {
  id          String   @id @default(uuid())
  receiptId   String
  receipt     Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  name        String
  category    String
  amount      Float
  description String?

  @@index([receiptId])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String   // "RECEIPT_ISSUED" | "RECEIPT_VOIDED" | "STUDENT_ENROLLED" | "SETTINGS_UPDATED"
  performedBy String
  details     String   @db.Text
  timestamp   DateTime @default(now())
}
